<?xml version="1.0" encoding="utf-8"?>
<!-- For serving the loader from IIS. Ignored by GitHub Pages and by any
     non IIS server, so it is safe to keep in the tree. -->
<configuration>
  <system.webServer>
    <staticContent>
      <!-- The per app ChangeLog files have no extension. IIS will not serve
           a file whose type it cannot map and answers 404 (404.3), so map
           the empty extension to plain text. -->
      <mimeMap fileExtension="." mimeType="text/plain" />
      <!-- IIS has no mapping for .md either, and the READMEs behind
           "Read more..." are markdown. -->
      <mimeMap fileExtension=".md" mimeType="text/markdown" />
    </staticContent>
    <security>
      <requestFiltering>
        <!-- The site root is a working copy - do not hand out its metadata,
             most of which is extensionless and now mapped above. -->
        <hiddenSegments>
          <add segment=".git" />
          <add segment=".vs" />
        </hiddenSegments>
      </requestFiltering>
    </security>
  </system.webServer>
</configuration>
